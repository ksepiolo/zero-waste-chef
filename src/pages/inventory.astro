---
import Layout from "@/layouts/Layout.astro";
import AppNav from "@/components/AppNav.astro";
import { createClient } from "@/lib/supabase";
import { listProducts } from "@/lib/services/product.service";
import { InventoryPanel } from "@/components/inventory/inventory-panel";
import type { ProductWithRisk } from "@/types";

let initialProducts: ProductWithRisk[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && Astro.locals.user) {
  try {
    initialProducts = await listProducts(supabase, Astro.locals.user.id);
  } catch {
    initialProducts = [];
  }
}
---

<Layout title="My Inventory">
  <div class="min-h-screen bg-white p-6 sm:p-10">
    <div class="mx-auto max-w-[1000px]">
      <AppNav email={Astro.locals.user?.email ?? ""} current="inventory" />
      <div class="mt-6 mb-8">
        <h1 class="font-display text-brand-ink text-2xl">My Inventory</h1>
        <p class="font-body text-brand-muted mt-1 text-sm">
          Add whatever you have on hand — even if it's just a few random ingredients.
        </p>
      </div>
      <InventoryPanel initialProducts={initialProducts} client:load />
    </div>
  </div>
</Layout>
