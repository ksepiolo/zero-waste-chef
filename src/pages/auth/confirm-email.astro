---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen flex-col items-center bg-white px-4 py-10">
    <div class="mb-10 flex items-center gap-2">
      <span class="bg-brand-surface text-brand-green flex h-[46px] w-[46px] items-center justify-center rounded-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22.5"
          height="22.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"
          ></path>
          <path d="M6 17h12"></path>
        </svg>
      </span>
      <span class="font-logo text-brand-ink text-[22px] leading-[22px] tracking-[-0.02em]">
        <span class="font-extrabold">Zero</span><span class="font-medium">Waste</span><span class="font-extralight"
          >Chef</span
        >
      </span>
    </div>

    <div class="border-brand-border w-full max-w-sm rounded-[20px] border bg-white p-8 text-center">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="font-display text-brand-ink mb-3 text-[32px]">
        {content.heading}
      </h1>
      <p class="text-brand-muted mb-6">{content.description}</p>
      <a href="/auth/signin" class="text-brand-green text-sm font-medium hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
