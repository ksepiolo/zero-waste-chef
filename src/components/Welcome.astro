---
import Topbar from "@/components/Topbar.astro";
import { Image } from "astro:assets";
import heroImage from "@/assets/images/home-hero.png";
---

<div class="min-h-screen w-full bg-white">
  <div class="mx-auto max-w-7xl p-4 sm:p-8">
    <Topbar />

    <div class="relative mt-4 min-h-[480px] overflow-hidden rounded-[20px] sm:min-h-[520px] lg:min-h-[544px]">
      <Image
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1728, 2160]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.52) 100%);"
      >
      </div>
      <div class="relative z-10 flex h-full flex-col justify-center gap-6 px-6 py-12 sm:px-12 sm:py-16 lg:px-16">
        <h1
          class="font-display text-brand-ink max-w-xl text-4xl leading-[1.2] tracking-[-0.02em] sm:text-5xl lg:text-[52px]"
        >
          Recipes for what's about to expire
        </h1>
        <p class="font-body text-brand-ink max-w-md text-base leading-[1.6] font-medium tracking-[-0.01em]">
          Zero Waste Chef tracks what's in your fridge, flags what's about to spoil, and turns those ingredients into a
          recipe you can cook tonight.
        </p>
        <a
          href="/auth/signup"
          class="font-body bg-brand-green hover:bg-brand-green/90 inline-flex h-12 w-fit items-center justify-center rounded-lg px-6 text-base font-semibold text-white transition-colors"
        >
          Get started
        </a>
      </div>
    </div>
  </div>
</div>
