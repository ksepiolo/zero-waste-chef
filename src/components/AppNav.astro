---
import { UserMenu } from "@/components/nav/user-menu";

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="border-brand-border border-b pb-4">
  <div class="flex flex-wrap items-center justify-between gap-y-3">
    <div class="flex items-center gap-8">
      <div class="flex items-center gap-2">
        <span class="bg-brand-surface text-brand-green flex h-[46px] w-[46px] items-center justify-center rounded-full">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22.5"
            height="22.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"
            ></path>
            <path d="M6 17h12"></path>
          </svg>
        </span>
        <span class="font-logo text-brand-ink text-[22px] leading-[22px] tracking-[-0.02em]">
          <span class="font-extrabold">Zero</span><span class="font-medium">Waste</span><span class="font-extralight"
            >Chef</span
          >
        </span>
      </div>

      <nav class="flex items-center gap-6">
        <a
          href="/inventory"
          class="font-body border-brand-green text-brand-ink border-b-[3px] pb-4 text-sm font-semibold"
        >
          Moja spiżarnia
        </a>
        <a href="/recipes" class="font-body text-brand-muted hover:text-brand-ink pb-4 text-sm font-semibold">
          Historia przepisów
        </a>
      </nav>
    </div>

    <UserMenu email={email} client:load />
  </div>
</div>
