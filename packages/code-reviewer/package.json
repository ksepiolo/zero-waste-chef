{
  "name": "@zero-waste-chef/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted code review built on the Vercel AI SDK and OpenRouter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/cli.ts",
    "start": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p evals/tsconfig.json",
    "lint": "eslint src evals",
    "test": "vitest run",
    "eval": "PROMPTFOO_DISABLE_TEMPLATING=true PROMPTFOO_FAILED_TEST_EXIT_CODE=1 promptfoo eval -c evals/promptfooconfig.yaml --output evals/output/latest.json",
    "eval:view": "promptfoo view -y",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.87",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^9.29.0",
    "promptfoo": "^0.122.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.11"
  }
}
