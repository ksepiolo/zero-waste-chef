{
  "name": "@zero-waste-chef/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted code review built on the Vercel AI SDK and OpenRouter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/cli.ts",
    "start": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.87",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
