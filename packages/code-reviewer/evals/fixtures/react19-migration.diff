-import React from "react";
-import ReactDOM from "react-dom";
+import { createRoot } from "react-dom/client";
+import type { Root } from "react-dom/client";
 
 import { ItemList } from "./item-list";
 
+// createRoot() must be called once per container; calling it twice on the same
+// node warns and drops the first tree, so the root is kept for re-renders.
+const roots = new WeakMap<HTMLElement, Root>();
+
 /** Mounts the listing into a server-rendered placeholder. */
 export function mountItemList(container: HTMLElement, categoryId: string) {
-  ReactDOM.render(<ItemList categoryId={categoryId} />, container);
+  let root = roots.get(container);
+
+  if (!root) {
+    root = createRoot(container);
+    roots.set(container, root);
+  }
+
+  root.render(<ItemList categoryId={categoryId} />);
 }
 
 export function unmountItemList(container: HTMLElement) {
-  ReactDOM.unmountComponentAtNode(container);
+  const root = roots.get(container);
+
+  if (root) {
+    root.unmount();
+    roots.delete(container);
+  }
 }
